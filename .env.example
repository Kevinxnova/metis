# MiniMax API key (for AI recommendations)
MINIMAX_API_KEY=

# Buttondown newsletter API key
BUTTONDOWN_API_KEY=

# Product Hunt API token (optional, scraper will skip if empty)
PRODUCTHUNT_API_TOKEN=

# API settings
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# Deployment: comma-separated allowed origins for CORS
# Add your Vercel URL here after deploying, e.g.:
# ALLOWED_ORIGINS=https://metis-xxx.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
