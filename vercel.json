{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/cron.py": {
      "maxDuration": 600
    }
  },
  "rewrites": [
    { "source": "/api/cron", "destination": "/api/cron.py" },
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 12 * * *"
    }
  ]
}
